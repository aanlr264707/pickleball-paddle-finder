# Copy to .env (or export these) to point the API at PostgreSQL instead of the default SQLite file.
DATABASE_URL=postgresql://paddle:paddle@localhost:5432/paddles

# 1 = load the CSV automatically when the paddles table is empty (default). 0 = seed manually.
AUTO_SEED=1

# Optional: serve the built React app from Flask (single-process deploy).
# FRONTEND_DIST=../frontend/dist
